{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "dependencies"
  ],
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 20,
  "prConcurrentLimit": 20,
  "packageRules": [
    {
      "groupName": "AndroidX Datastore dependencies",
      "matchPackageNames": [
        "androidx.datastore:datastore-preferences-core",
        "androidx.datastore:datastore-preferences"
      ]
    },
    {
      "groupName": "Firebase Pod dependencies",
      "matchPackageNames": [
        "FirebaseFirestore",
        "FirebaseDatabase",
        "FirebaseCrashlytics",
        "FirebaseCore",
        "FirebaseAnalytics"
      ]
    },
    {
      "groupName": "Firebase KMP dependencies",
      "matchPackageNames": [
        "dev.gitlive:firebase-firestore",
        "dev.gitlive:firebase-database",
        "dev.gitlive:firebase-crashlytics",
        "dev.gitlive:firebase-analytics"
      ]
    }
  ]
}
